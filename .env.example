# Spectra-Web environment — copy to `.env` and fill in.
# Used by the anonymous telemetry ingest + admin dashboard.

# Password for the /admin telemetry dashboard. Generate a long random value, e.g.
#   openssl rand -hex 32
# Required — without it /admin and the stats API stay locked.
ADMIN_TOKEN=

# Optional soft anti-spam key. If set, the launcher must send the same value in
# the `x-spectra-key` header (set INGEST_KEY in the launcher's useTelemetry.ts to
# match). Leave empty to accept any client.
SPECTRA_INGEST_KEY=

# Postgres — accounts, friends, notifications, share codes and telemetry all
# live here. Nothing is stored inside the container any more, so a redeploy no
# longer risks the data.
#   postgresql://user:password@host:5432/database
DATABASE_URL=

# --- Accounts (better-auth) -------------------------------------------------


# Signs sessions and launcher tokens. Required in production; changing it logs
# everyone out.  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Transactional mail (e-mail verification, password resets). Without a key those
# links are only printed to the server log and e-mail verification is not
# enforced, which is fine for local dev and wrong for production.
RESEND_API_KEY=
# Must be on the domain the Resend key is authorised for, otherwise every
# send comes back 403 "not authorized to send emails from ...".
MAIL_FROM=Spectra <noreply@makoto.com.pl>

# Social sign-in. A provider only shows up on the sign-in page once both of its
# values are set. Redirect/callback URL to register with each provider:
#   <site>/api/auth/callback/<discord|google|github|microsoft>
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Storage (Cloudflare R2) ------------------------------------------------
# Holds avatars and shared modpacks. Without all five values avatar uploads
# return 501 and large packs cannot be shared at all (the launcher falls back to
# the 100 MB route through this server, which is all Cloudflare's proxy allows).
#
# Packs are deleted when their code expires, so no lifecycle rule is needed.
# R2_PUBLIC_URL is only used for avatars — they need public read access, whereas
# packs are always served through short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=spectra-avatars
R2_PUBLIC_URL=https://cdn.spectra.makoto.com.pl

# --- Turnstile --------------------------------------------------------------
# Bot protection on sign-up, sign-in and password resets. Both values must be
# set; with the secret missing the widget is not rendered and nothing is
# verified. Cloudflare dashboard → Turnstile → add a site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Discord ----------------------------------------------------------------
# Powers the admin panel's Discord tab: server stats, sending messages and
# editing ones the bot posted earlier. Both values must be set; without them the
# tab renders and says it is not configured, and the endpoints answer 501.
#
# The token is a *bot* token from the Discord developer portal
# (Applications → your app → Bot → Reset Token), not an OAuth client secret —
# DISCORD_CLIENT_ID/SECRET above are a separate thing, used for signing in.
# The bot has to be invited to the guild with the "Send Messages" and
# "Read Message History" permissions before any of this works.
#
# Only actions started by a click go through here. Anything that reacts to
# events on Discord — welcomes, tickets, slash commands — needs a live gateway
# connection and lives in the separate bot process, not in this app.
#
# GUILD_ID is the server's own id: enable Developer Mode in Discord, then
# right-click the server → Copy Server ID.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Shared secret for GitHub's `release` webhook (repo settings → Webhooks →
# payload URL /api/hooks/github-release, content type JSON, event "Releases").
# Publishing a launcher release then posts it in the channel picked in the
# panel under Bot configuration → Launcher releases. Any random string; it is
# only ever compared against the signature GitHub sends.
GITHUB_WEBHOOK_SECRET=
